
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>

    <link rel="stylesheet" href="/css/single.css">
</head>
<body>

    <div class="product-details">

        <h1>Product Details</h1>

        <div class="product-image">
            <img src="{{daaata.product_image}}" alt="{{daaata.productName}}">
        </div>

        <div class="product-info">

            <h2>{{daaata.productName}}</h2>

            <p class="price">₹{{daaata.productPrice}}</p>

            {{!-- <p class="description">
                Product information and details. --}}
            {{!-- </p> --}}

            <a href="/products/home" class="back-btn">
                Back to Products
            </a>

            <form action="/products/delete/{{daaata._id}}" method="POST"
      onsubmit="return confirm('Are you sure you want to delete this product?')">

    <button type="submit" class="delete-btn">
        Delete Product
    </button>
</form>

<a href="/products/update/{{daaata._id}}" class="update-btn">
    Update Product
</a>
        </div>

    </div>

</body>
</html>
